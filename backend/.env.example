# === Sapar Backend — пример переменных окружения ===
# Скопируй этот файл в backend/.env для локальной разработки.
# На Render те же переменные задаются в Dashboard → Environment.

# Порт (Render задаёт автоматически, локально по умолчанию 5000)
PORT=5000

# Окружение
NODE_ENV=development

# === Groq AI ===
# Получить ключ: https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-20b

# === MongoDB ===
# Если не задан — backend стартует без БД, /api/itinerary вернёт 503.
# Бесплатный облачный Mongo: https://www.mongodb.com/cloud/atlas
MONGO_URI=

# === CORS ===
# Список доменов через запятую — откуда можно делать запросы.
# Для прода: https://sapar.vercel.app
# Для отладки: можно поставить * (открыто всем)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# === Clerk (опционально для защищённых эндпоинтов) ===
# Получить: https://dashboard.clerk.com/ → API Keys → Secret key
CLERK_SECRET_KEY=
